{
  "compileOnSave": false,
  "compilerOptions": {
    "strict": false,
    "skipLibCheck": true,
    "isolatedModules": true,
    "noImplicitOverride": true,
    "target": "ES2022",
    "module": "preserve",
    "moduleResolution": "bundler",
    "importHelpers": true,
    "lib": [
      "ES2022",
      "dom"
    ],
    "paths": {
      "@core/*": [
        "./src/app/core/*"
      ],
      "@shared/*": [
        "./src/app/shared/*"
      ],
      "@features/*": [
        "./src/app/features/*"
      ],
      "@models": [
        "./src/app/models/index.ts"
      ]
    }
  },
  "angularCompilerOptions": {
    "strictTemplates": false
  }
}